# Copie para ".env.local" (ignorado pelo Git) e preencha.
# Variáveis com prefixo VITE_ são embutidas no bundle do navegador: são PÚBLICAS.
# Nunca coloque segredos de verdade aqui.

# Fonte das hamburguerias:
#   geoapify (padrão) = dados reais do OpenStreetMap via Geoapify Places API
#   overpass          = dados reais via Overpass API (mantida temporariamente)
#   mock              = MODO DEMONSTRAÇÃO, dados simulados, sem acessar a rede
VITE_PLACES_PROVIDER=geoapify

# Chave da Geoapify (plano gratuito, sem cartão): https://myprojects.geoapify.com
# Ela fica visível no navegador. Proteja-a no painel da Geoapify liberando só os
# endereços do app (ex.: http://localhost:5173 e o domínio publicado).
VITE_GEOAPIFY_API_KEY=

# Servidor da Overpass API (só para VITE_PLACES_PROVIDER=overpass).
# Vazio = https://overpass-api.de/api/interpreter. Só aceita https (ou http em localhost).
VITE_OVERPASS_URL=

# Estilo do mapa (MapLibre GL JS). Vazio = OpenFreeMap "liberty":
#   https://tiles.openfreemap.org/styles/liberty  (gratuito, sem chave, uso comercial permitido)
# Outros estilos do OpenFreeMap: .../styles/bright e .../styles/positron
VITE_MAP_STYLE_URL=

# Google Tag Manager (só entra no build de produção). Vazio = GTM-MCGKVLLR.
VITE_GTM_ID=
