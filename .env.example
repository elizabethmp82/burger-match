# Copie este arquivo para ".env.local" (ignorado pelo Git) e preencha os valores.
# Variáveis com prefixo VITE_ são embutidas no bundle do navegador: são PÚBLICAS.
# Nunca coloque aqui segredos de servidor.

# Chave da Google Maps Platform (configurada na Etapa 4).
# Deve ser restrita por referenciador HTTP (domínio) e pelas APIs utilizadas.
VITE_GOOGLE_MAPS_API_KEY=
