# Copie este arquivo para ".env.local" (ignorado pelo Git) e preencha os valores.
# Variáveis com prefixo VITE_ são embutidas no bundle do navegador: são PÚBLICAS.
# Nunca coloque aqui segredos de servidor.
#
# Passo a passo para criar a chave: docs/google-maps-setup.md

# Chave da Google Maps Platform.
# Deixe vazia para usar o MODO DEMONSTRAÇÃO (dados simulados, sem custo).
# A chave deve ser restrita por referenciador HTTP (domínio) e pelas APIs utilizadas.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID (opcional). Necessário para os marcadores do mapa.
# Vazio = "DEMO_MAP_ID", o ID de demonstração do Google (bom para desenvolvimento).
VITE_GOOGLE_MAPS_MAP_ID=
